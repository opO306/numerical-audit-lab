+HX='0x0.0p+0'
+def successor(parent, *, final=False, session='a'*64):
+    from verified_driver.v1.model import FormLane, canonical_bytes, digest_bytes
+    k=parent.generation+1
+    q=('0x3f70000000000000','0x3f60000000000000')
